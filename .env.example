# TCN Environment Configuration Template
# Copy this file to .env.local for local development.

# Supabase Local or Cloud Credentials
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# UPI Manual Payments (Default Provider)
VITE_PUBLIC_UPI_ID=thecuenation@okaxis
VITE_PUBLIC_PAYEE_NAME=The Cue Nation

# Payment Gateway Configuration (Edge Function Secrets - NEVER expose in client)
# Active Provider: manual_upi | mock_gateway | razorpay
# Active Mode: test | live
RAZORPAY_KEY_ID=rzp_test_YourKeyHere
RAZORPAY_KEY_SECRET=YourSecretHere
RAZORPAY_WEBHOOK_SECRET=YourWebhookSecretHere

# Mock Gateway Secret (for dev/test simulated webhook signing)
MOCK_GATEWAY_SECRET=mock-secret-key-12345

# Authentication & Local Mailer
# Local Supabase Inbucket mail catcher: http://localhost:54324
AUTH_REQUIRE_EMAIL_CONFIRM=false

# Google OAuth Setup (Supabase Auth Providers)
# 1. Create Web Client in Google Cloud Console
# 2. Add Authorised redirect URI: http://127.0.0.1:54321/auth/v1/callback (local) or https://<project-ref>.supabase.co/auth/v1/callback
# 3. Supply Client ID & Secret in Supabase Dashboard > Authentication > Providers > Google
